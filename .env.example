# FieldCompliance — Environment Variables
# Copy to .env and fill in values

# -------------------------------------------------------
# Database (Postgres)
# -------------------------------------------------------
DATABASE_URL="postgresql://erik:localdev@localhost:5432/fieldcompliance"

# -------------------------------------------------------
# Auth
# -------------------------------------------------------
JWT_SECRET="REDACTED"
JWT_EXPIRY="7d"

# -------------------------------------------------------
# Storage (DigitalOcean Spaces or AWS S3)
# -------------------------------------------------------
S3_BUCKET="fieldcompliance-uploads"
S3_REGION="us-east-1"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_ENDPOINT=""   # set for DO Spaces: https://nyc3.digitaloceanspaces.com

# -------------------------------------------------------
# Email (SendGrid)
# -------------------------------------------------------
SENDGRID_API_KEY=REDACTED
SENDGRID_FROM_EMAIL=contact@houghworks.com
SENDGRID_FROM_NAME=FieldCompliance

# -------------------------------------------------------
# SMS (Twilio — optional, for alert escalation)
# -------------------------------------------------------
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# -------------------------------------------------------
# Stripe (billing)
# -------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_GROWTH=""
STRIPE_PRICE_PRO=""

# -------------------------------------------------------
# App
# -------------------------------------------------------
NODE_ENV="development"
PORT=3001
FRONTEND_URL="http://localhost:3000"
