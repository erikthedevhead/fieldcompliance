// ============================================================
// FieldCompliance — Prisma Schema
// Multi-tenant oilfield environmental compliance platform
// ============================================================
generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}
// ============================================================
// ENUMS
// ============================================================
enum UserRole {
  ORG_ADMIN        // manages billing, users, all facilities
  EHS_COORDINATOR  // full data entry + report generation
  SITE_MANAGER     // scoped to assigned facilities
  FIELD_TECH       // mobile entry only
  AUDITOR          // read-only across org
}
enum FacilityType {
  PRODUCTION_WELL
  INJECTION_WELL
  COMPRESSOR_STATION
  GATHERING_PIPELINE
  PROCESSING_PLANT
  STORAGE_TANK_BATTERY
  MIDSTREAM_FACILITY
}
enum EquipmentCategory {
  PNEUMATIC_CONTROLLER
  PNEUMATIC_PUMP
  STORAGE_TANK
  SEPARATOR
  COMPRESSOR_RECIPROCATING
  COMPRESSOR_CENTRIFUGAL
  DEHYDRATOR_GLYCOL
  METER_SEPARATOR
  FLARE_SYSTEM
  WELLHEAD
  FUGITIVE_COMPONENT
}
enum PneumaticDeviceType {
  CONTINUOUS_HIGH_BLEED
  INTERMITTENT_BLEED
  CONTINUOUS_LOW_BLEED
}
enum EmissionSource {
  VENTING
  FUGITIVE
  COMBUSTION
  FLARING
  PROCESS_UPSET
}
enum RegulationJurisdiction {
  FEDERAL_EPA
  TEXAS_TCEQ
  OKLAHOMA_DEQ
  NEW_MEXICO_NMED
  COLORADO_COGCC
  WYOMING_DEQ
  NORTH_DAKOTA_DEH
}
enum ReportStatus {
  DRAFT
  IN_REVIEW
  SUBMITTED
  ACCEPTED
  REJECTED
  AMENDED
}
enum DeadlineStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
  WAIVED
}
enum AuditAction {
  CREATE
  UPDATE
  DELETE
  EXPORT
  SUBMIT
  LOGIN
  PERMISSION_CHANGE
}
// ============================================================
// MULTI-TENANCY — Organizations
// ============================================================
model Organization {
  id               String    @id @default(cuid())
  name             String
  slug             String    @unique
  dotNumber        String?
  epaReporterCode  String?
  taxId            String?
  billingEmail     String
  planTier         String    @default("starter")
  maxFacilities    Int       @default(10)
  trialEndsAt      DateTime?
  subscriptionId   String?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  users            User[]
  facilities       Facility[]
  regulations      OrgRegulation[]
  reports          ComplianceReport[]
  auditLogs        AuditLog[]
  apiKeys          ApiKey[]
  @@index([slug])
}
// ============================================================
// USERS
// ============================================================
model User {
  id                String    @id @default(cuid())
  orgId             String
  email             String    @unique
  firstName         String
  lastName          String
  role              UserRole  @default(FIELD_TECH)
  phone             String?
  isActive          Boolean   @default(true)
  lastLoginAt       DateTime?
  resetToken        String?
  resetTokenExpiry  DateTime?
  inviteToken       String?
  inviteTokenExpiry DateTime?
  invitedAt         DateTime?
  invitedBy         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  passwordHash      String?
  org               Organization    @relation(fields: [orgId], references: [id])
  facilityAccess    UserFacility[]
  auditLogs         AuditLog[]
  inspections       Inspection[]
  assignedDeadlines Deadline[]
  @@index([orgId])
  @@index([email])
}
model UserFacility {
  userId      String
  facilityId  String
  grantedAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  facility    Facility @relation(fields: [facilityId], references: [id])
  @@id([userId, facilityId])
}
// ============================================================
// FACILITIES & EQUIPMENT
// ============================================================
model Facility {
  id                String       @id @default(cuid())
  orgId             String
  name              String
  type              FacilityType
  apiWellNumber     String?
  state             String
  county            String?
  latitude          Decimal?     @db.Decimal(10, 7)
  longitude         Decimal?     @db.Decimal(10, 7)
  legalDescription  String?
  /// CH4 mole fraction of produced gas, 0–1. §98.233(u)(2) requires
  /// facility-specific composition for Subpart W calcs. Null → the
  /// calculator falls back to DEFAULT_CH4_MOLE_FRACTION (units.ts) and
  /// stamps assumedComposition: true into the record's activityData.
  ch4MoleFraction   Decimal?     @db.Decimal(5, 4)
  /// CO2 mole fraction of produced gas, 0–1. Reserved for the vented-CO2
  /// leg of Eq. W-1B (not yet calculated by the orchestrator).
  co2MoleFraction   Decimal?     @db.Decimal(5, 4)
  operatorId        String?
  isActive          Boolean      @default(true)
  commissionedAt    DateTime?
  decommissionedAt  DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  org               Organization     @relation(fields: [orgId], references: [id])
  equipment         Equipment[]
  userAccess        UserFacility[]
  inspections       Inspection[]
  deadlines         Deadline[]
  emissionRecords   EmissionRecord[]
  reports           ComplianceReport[]
  @@index([orgId])
  @@index([state])
  @@index([orgId, isActive])
}
model Equipment {
  id               String            @id @default(cuid())
  facilityId       String
  tag              String
  category         EquipmentCategory
  description      String?
  manufacturer     String?
  model            String?
  serialNumber     String?
  installDate      DateTime?
  lastServiceDate  DateTime?
  isActive         Boolean           @default(true)
  // Emission-relevant attributes per equipment type
  pneumaticType    PneumaticDeviceType?
  tankCapacityBbls Decimal?          @db.Decimal(10, 2)
  compressorHp     Int?
  throughputMcfd   Decimal?          @db.Decimal(10, 2)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  facility         Facility          @relation(fields: [facilityId], references: [id])
  emissionRecords  EmissionRecord[]
  inspections      Inspection[]
  @@index([facilityId])
  @@index([facilityId, category])
  @@unique([facilityId, tag])
}
// ============================================================
// REGULATIONS — Versioned rules engine
// ============================================================
model Regulation {
  id                 String                 @id @default(cuid())
  code               String                 @unique
  title              String
  jurisdiction       RegulationJurisdiction
  cfrPart            String?
  federalRegisterUrl String?
  description        String?
  isActive           Boolean                @default(true)
  versions           RegulationVersion[]
  orgRegulations     OrgRegulation[]
  @@index([jurisdiction])
}
model RegulationVersion {
  id            String    @id @default(cuid())
  regulationId  String
  version       String
  effectiveDate DateTime
  expiresAt     DateTime?
  changeNotes   String?
  rawJsonSchema Json
  createdAt     DateTime  @default(now())
  regulation    Regulation       @relation(fields: [regulationId], references: [id])
  requirements  RegulationRule[]
  deadlines     Deadline[]
  @@index([regulationId, effectiveDate])
}
model RegulationRule {
  id                  String             @id @default(cuid())
  regulationVersionId String
  ruleCode            String
  title               String
  description         String
  equipmentCategory   EquipmentCategory?
  emissionSource      EmissionSource?
  requirementType     String             // SURVEY | REPORT | CALCULATE | RECORD | SUBMIT
  frequencyDays       Int?
  thresholdValue      Decimal?           @db.Decimal(10, 4)
  thresholdUnit       String?            // tpy | scfd | ppm
  deadlineOffsetDays  Int?
  penaltyPerDay       Decimal?           @db.Decimal(10, 2)
  notes               String?
  regulationVersion   RegulationVersion  @relation(fields: [regulationVersionId], references: [id])
  @@index([regulationVersionId])
  @@index([equipmentCategory])
}
model OrgRegulation {
  orgId        String
  regulationId String
  enrolledAt   DateTime @default(now())
  enrolledBy   String?
  notes        String?
  org          Organization @relation(fields: [orgId], references: [id])
  regulation   Regulation   @relation(fields: [regulationId], references: [id])
  @@id([orgId, regulationId])
}
// ============================================================
// DEADLINES — Core daily-use feature
// ============================================================
model Deadline {
  id                  String         @id @default(cuid())
  orgId               String
  facilityId          String
  regulationVersionId String
  ruleCode            String
  title               String
  description         String?
  dueDate             DateTime
  periodStart         DateTime?
  periodEnd           DateTime?
  status              DeadlineStatus @default(PENDING)
  assignedUserId      String?
  completedAt         DateTime?
  completedBy         String?
  notes               String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  facility          Facility          @relation(fields: [facilityId], references: [id])
  regulationVersion RegulationVersion @relation(fields: [regulationVersionId], references: [id])
  assignedUser      User?             @relation(fields: [assignedUserId], references: [id])
  alerts            DeadlineAlert[]
  @@index([orgId, status])
  @@index([orgId, dueDate])
  @@index([facilityId])
}
model DeadlineAlert {
  id          String    @id @default(cuid())
  deadlineId  String
  alertType   String    // EMAIL | SMS | IN_APP
  scheduledAt DateTime
  sentAt      DateTime?
  recipient   String
  channel     String    // sendgrid | twilio | internal
  deadline    Deadline  @relation(fields: [deadlineId], references: [id])
  @@index([deadlineId])
  @@index([scheduledAt, sentAt])
}
// ============================================================
// INSPECTIONS — Offline-capable field data entry
// ============================================================
model Inspection {
  id                String    @id @default(cuid())
  facilityId        String
  equipmentId       String?
  inspectorId       String
  inspectionType    String    // OGI | METHOD_21 | VISUAL | AVO | LDAR_SURVEY
  conductedAt       DateTime
  weatherConditions String?
  windSpeedMph      Decimal?  @db.Decimal(5, 1)
  ambientTempF      Decimal?  @db.Decimal(5, 1)
  findings          String?
  leakDetected      Boolean   @default(false)
  repairDeadline    DateTime?
  repairedAt        DateTime?
  photoUrls         String[]
  gpsLat            Decimal?  @db.Decimal(10, 7)
  gpsLng            Decimal?  @db.Decimal(10, 7)
  syncedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  facility          Facility   @relation(fields: [facilityId], references: [id])
  equipment         Equipment? @relation(fields: [equipmentId], references: [id])
  inspector         User       @relation(fields: [inspectorId], references: [id])
  @@index([facilityId, conductedAt])
  @@index([inspectorId])
}
// ============================================================
// EMISSIONS — Calculated records
// ============================================================
model EmissionRecord {
  id                   String         @id @default(cuid())
  facilityId           String
  equipmentId          String?
  reportingPeriodStart DateTime
  reportingPeriodEnd   DateTime
  emissionSource       EmissionSource
  pollutant            String         // CH4 | CO2 | N2O | VOC | NOx
  calculationMethod    String         // AP42 | SITE_SPECIFIC | OGI_MEASUREMENT | ENGINEERING_EST
  emissionFactorId     String?
  activityData         Json
  calculatedQuantity   Decimal        @db.Decimal(14, 4)
  unit                 String         // tpy | scf | mt-CO2e
  co2Equivalent        Decimal?       @db.Decimal(14, 4)
  verifiedAt           DateTime?
  verifiedBy           String?
  notes                String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  facility             Facility        @relation(fields: [facilityId], references: [id])
  equipment            Equipment?      @relation(fields: [equipmentId], references: [id])
  emissionFactor       EmissionFactor? @relation(fields: [emissionFactorId], references: [id])
  @@index([facilityId, reportingPeriodStart])
  @@index([facilityId, pollutant])
}
// EPA-approved emission factors — seeded from AP-42, OOOOb, Subpart W tables
model EmissionFactor {
  id                  String            @id @default(cuid())
  source              String            // AP42 | OOOOb | SUBPART_W | SITE_SPECIFIC
  equipmentCategory   EquipmentCategory
  pollutant           String
  /// Variant discriminator within an equipmentCategory — e.g. a
  /// PneumaticDeviceType value for PNEUMATIC_CONTROLLER factors.
  /// Replaces the old notes-string matching in lookupFactor().
  subType             String?
  factorValue         Decimal           @db.Decimal(14, 6)
  factorUnit          String            // scf-whole-gas/hr | tpy/unit | lb/MMscf
  applicableFrom      DateTime
  applicableUntil     DateTime?
  notes               String?
  federalRegCitation  String?
  emissionRecords     EmissionRecord[]
  @@index([equipmentCategory, pollutant, subType])
}
// ============================================================
// REPORTS — Generated compliance submissions
// ============================================================
model ComplianceReport {
  id                  String       @id @default(cuid())
  orgId               String
  facilityId          String?
  reportType          String       // SUBPART_W | OOOOb | TCEQ_ANNUAL | CUSTOM
  reportingYear       Int
  periodStart         DateTime
  periodEnd           DateTime
  status              ReportStatus @default(DRAFT)
  generatedAt         DateTime?
  submittedAt         DateTime?
  submittedBy         String?
  eggrtConfirmationId String?
  xmlPayload          String?
  pdfS3Key            String?
  reviewNotes         String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  org                 Organization @relation(fields: [orgId], references: [id])
  facility            Facility?    @relation(fields: [facilityId], references: [id])
  @@index([orgId, reportingYear])
  @@index([orgId, status])
}
// ============================================================
// AUDIT LOG — Immutable, append-only
// ============================================================
model AuditLog {
  id          String      @id @default(cuid())
  orgId       String
  userId      String?
  action      AuditAction
  entityType  String
  entityId    String
  beforeState Json?
  afterState  Json?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime    @default(now())
  org         Organization @relation(fields: [orgId], references: [id])
  user        User?        @relation(fields: [userId], references: [id])
  @@index([orgId, createdAt])
  @@index([entityType, entityId])
  @@index([userId, createdAt])
}
// ============================================================
// API KEYS — Consultant / third-party access
// ============================================================
model ApiKey {
  id         String    @id @default(cuid())
  orgId      String
  name       String
  keyHash    String    @unique
  prefix     String
  scopes     String[]
  lastUsedAt DateTime?
  expiresAt  DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  org        Organization @relation(fields: [orgId], references: [id])
  @@index([orgId])
}
