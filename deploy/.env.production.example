# FieldCompliance — Production Environment
# Fill in and save as .env at the repo root on the droplet

# -------------------------------------------------------
# Database
# -------------------------------------------------------
# Password from setup-droplet.sh output
DATABASE_URL="postgresql://fc:REPLACE_ME@localhost:5432/fieldcompliance"

# -------------------------------------------------------
# Auth
# -------------------------------------------------------
# Generate with: openssl rand -hex 64
JWT_SECRET="REPLACE_WITH_STRONG_RANDOM_STRING"
JWT_EXPIRY="7d"

# -------------------------------------------------------
# App
# -------------------------------------------------------
NODE_ENV="production"
PORT=3001
# Set to the Vercel URL after the frontend is deployed
FRONTEND_URL="https://fieldcompliance.vercel.app"

# -------------------------------------------------------
# Placeholders — not wired up yet, can stay blank for MVP
# -------------------------------------------------------
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_ENDPOINT=""

SENDGRID_API_KEY=""
EMAIL_FROM=""

TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_GROWTH=""
STRIPE_PRICE_PRO=""
